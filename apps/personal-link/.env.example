# Server runtime settings. Configure sensitive values in Coolify.
DATABASE_URL=
APP_ORIGIN=
ADMIN_PASSWORD_HASH=
PORT=3000

# Optional comma-separated IPs or CIDRs of ingress proxies that sanitize X-Forwarded-For.
TRUSTED_PROXIES=

# Optional for local builds. Production images embed their Git commit.
APP_RELEASE=

# Optional Meta Instagram Business Discovery. Keep the access token server-side.
INSTAGRAM_GRAPH_API_URL=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_ACCESS_TOKEN=

# Public portfolio origin for the admin navigation. The build embeds this value in the client.
VITE_LEVELUP_SITE_ORIGIN=
